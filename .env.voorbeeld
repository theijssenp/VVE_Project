# .env.voorbeeld — alle variabelen die infra/docker-compose.yml nodig heeft (blok F02, spec §7.9/§8.2).
#
# KOPIEER DIT BESTAND NAAR .env (dat staat in .gitignore; nooit committen) en vul het:
#   cp .env.voorbeeld .env
#
# OMGANG MET SECRETS (spec §7.9):
#   - Het .env-bestand bevat echte wachtwoorden en staat BUITEN de repository.
#   - Bestandsrechten MOETEN 600 zijn:   chmod 600 .env
#   - De versleutelingssleutels voor IBAN-kolommen mogen NIET in dezelfde backup
#     staan als de database (dat geldt later, F03/B01).
#
# Geen enkele waarde hieronder is een echt secret — alleen sjablonen.

# --- PostgreSQL (spec §7.9) ---
POSTGRES_USER=vve
POSTGRES_PASSWORD=verander-dit-naar-een-werkelijk-secret
POSTGRES_DB=vve
# Lokaal: Postgres luistert ALLEEN op 127.0.0.1 (geen publieke interface). In productie
# blijft de mapping weg en is Postgres alleen binnen het compose-netwerk bereikbaar.
POSTGRES_PORT_MAPPING=127.0.0.1:5432:5432

# --- API (NestJS) ---
NODE_ENV=production
# Poort waar de api-container naar binnen luistert (Caddy proxy'ert ertegen).
API_PORT=3000

# Let op: bestandsrechten zijn geen omgevingsvariabele. Zet ze met `chmod 600 .env`
# (zie infra/README.md).

# --- Authenticatie (spec §7.6/§8.2) ---
# Geheim waarmee access tokens worden getekend. Minimaal 32 tekens; er is
# bewust GEEN standaardwaarde in de code, want een ingebakken geheim laat
# iedereen die de broncode kan lezen tokens vervalsen.
# Genereer er een met:  openssl rand -base64 48
JWT_SECRET=verander-dit-in-een-willekeurig-geheim-van-minstens-32-tekens

# Sleutel voor kolomversleuteling (TOTP-secret nu, IBAN-kolommen vanaf B01).
# Minimaal 32 tekens, geen standaardwaarde in de code: met deze sleutel plus een
# databasedump zijn de tweede factoren van alle gebruikers te herleiden.
# Bewaar hem NIET in dezelfde back-up als de database (spec §7.9).
# Genereer er een met:  openssl rand -base64 48
KOLOM_SLEUTEL=verander-dit-in-een-willekeurige-sleutel-van-minstens-32-tekens

# --- WebAuthn / passkeys (blok F07) ---
# Zonder deze twee werken de passkey-routes niet; TOTP blijft wél werken.
# RP_ID is de kale domeinnaam (geen protocol, geen poort) en ORIGIN de volledige
# herkomst waarvandaan registratie en authenticatie mogen komen. Een verkeerde
# waarde maakt passkeys stil onbruikbaar, of erger: bruikbaar vanaf een domein
# dat niet van ons is.
# Lokaal:      WEBAUTHN_RP_ID=localhost  en  WEBAUTHN_ORIGIN=http://localhost:4200
# Productie:   WEBAUTHN_RP_ID=vve.example.nl  en  WEBAUTHN_ORIGIN=https://vve.example.nl
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4200
WEBAUTHN_RP_NAAM=VvE-beheer

# --- Documentopslag (blok V05) ---
# Map waarin de geüploade documenten staan, BUITEN de webroot (§6.6): de API
# levert ze alleen uit via het downloadendpoint, nooit als statisch bestand.
# Geen standaardwaarde — een applicatie die stilletjes ergens anders opslaat dan
# bedoeld is erger dan een die niet start (§8.2). De map moet bestaan en
# schrijfbaar zijn voor de gebruiker waaronder de API draait.
# Lokaal:     DOCUMENTEN_MAP=./var/documenten
# Productie:  DOCUMENTEN_MAP=/var/lib/vve/documenten  (eigen volume, in de back-up)
DOCUMENTEN_MAP=./var/documenten
