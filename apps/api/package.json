{
  "name": "@vve/api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "db:migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/database/run-migraties.ts",
    "db:opnieuw": "node --env-file-if-exists=../../.env --experimental-strip-types src/database/opnieuw-opbouwen.ts",
    "db:opnieuw:seed": "npm run db:opnieuw && npm run seed:beheerder --",
    "seed:beheerder": "npm run build && node --env-file-if-exists=../../.env dist/src/database/seeds/beheerder.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.23.1",
    "@vve/contract": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.31.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.0"
  }
}
